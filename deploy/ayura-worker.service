# systemd unit: the background worker (order emails, Razorpay reconcile, draft expiry,
# stock-hold expiry, review requests). Restarts on failure and starts at boot.
[Unit]
Description=Ayura store - background worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ayura
Group=ayura
WorkingDirectory=/srv/ayura/backend
EnvironmentFile=/srv/ayura/backend/.env
ExecStart=/srv/ayura/backend/venv/bin/python manage.py run_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
