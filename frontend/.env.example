# frontend/.env.example - copy to frontend/.env.local to override defaults. Never commit real values.
# [OPTIONAL] Django API base URL, with trailing slash. Default http://127.0.0.1:8000/api/v1/
# In production also used to preconnect to the API from index.html (see vite.config.js).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/
# [OPTIONAL] Django server root, with trailing slash. Default http://127.0.0.1:8000/
VITE_SERVER_URL=http://127.0.0.1:8000/
# [OPTIONAL] PayPal JS SDK client id (public). Default "test" (PayPal sandbox demo).
VITE_PAYPAL_CLIENT_ID=test
# [NEEDS YOUR VALUE] Support email shown in the footer, contact page and policies. Default is a placeholder.
VITE_SUPPORT_EMAIL=support@example.com
# WhatsApp number for the wa.me link: digits only, country code first, no "+".
# Ayura's number (supplied by the owner, 11 Oct 2026). Without it the placeholder 910000000000 is used.
VITE_WHATSAPP_NUMBER=917888548215
# [OPTIONAL] Store name shown in the header, footer, page titles and policies. Default "Ayura".
VITE_STORE_NAME=Ayura
# [OPTIONAL] The one-line promise on the home page and in the footer.
# Default "If we wouldn't use it at home, we don't bottle it."
VITE_TAGLINE=If we wouldn’t use it at home, we don’t bottle it.
# [OPTIONAL] The page description search engines show. Default "Skin, hair and body care, made fresh in small batches."
VITE_STORE_DESCRIPTION=Skin, hair and body care, made fresh in small batches.
